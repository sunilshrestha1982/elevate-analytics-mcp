PORT=8080
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8080,https://app.example.com
COOKIE_SAMESITE=lax
COOKIE_SECURE_OVERRIDE=false
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=300
REQUEST_TIMEOUT_MS=30000
REDIS_URL=""
