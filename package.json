{
  "name": "elevate-analytics-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-ready analytics + MCP platform with Cloud Run deployment support",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/server.js",
    "check:env": "node scripts/check-env.mjs",
    "docker:build": "docker build -t elevate-analytics-mcp:local .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env elevate-analytics-mcp:local",
    "deploy:cloudrun": "bash scripts/deploy-cloud-run.sh",
    "deploy": "bash deploy.sh",
    "rollback": "bash rollback.sh",
    "check:production": "bash scripts/production-check.sh",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prisma:init": "prisma init --datasource-provider postgresql",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.22.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.4"
  }
}
